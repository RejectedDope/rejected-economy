# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and will never be committed.
# See docs/deployment.md for full setup instructions.

# ─── Supabase ────────────────────────────────────────────────────────────────
# Required for all features. Find these in:
# Supabase Dashboard → Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Required for cron jobs and eBay sync (server-side only).
# Find in: Supabase Dashboard → Project → Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── App URL ─────────────────────────────────────────────────────────────────
# The public base URL of this deployment. Used for eBay OAuth callback redirects.
# Local dev: http://localhost:3000
# Production: https://your-domain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── eBay OAuth ──────────────────────────────────────────────────────────────
# Required for eBay marketplace connection and live sync.
# Get these from: https://developer.ebay.com → Application Keys
# The redirect URI must be registered in your eBay app's OAuth settings and
# must exactly match: {NEXT_PUBLIC_APP_URL}/api/auth/marketplace/ebay/callback
EBAY_CLIENT_ID=your-ebay-client-id
EBAY_CLIENT_SECRET=your-ebay-client-secret
EBAY_REDIRECT_URI=http://localhost:3000/api/auth/marketplace/ebay/callback

# ─── Cron Secret ─────────────────────────────────────────────────────────────
# Shared secret used to authenticate cron route calls.
# Required for: automation cron, eBay sync cron, snapshots cron, queue cleanup.
# Vercel sets this automatically via the CRON_SECRET env var in your project.
# For local testing, set any random string here and pass it as a Bearer token.
CRON_SECRET=your-cron-secret-here

# ─── Rejected Treasures Photo Intake ────────────────────────────────────────
# Internal connection key entered once in the Vault Scan mobile app. Keep this
# server-side; never commit the real value or expose it as EXPO_PUBLIC_*.
PHOTO_INTAKE_KEY=generate-a-long-random-value

# Microsoft Entra app credentials for the existing site-limited Graph bridge.
MS_TENANT_ID=your-tenant-id
MS_CLIENT_ID=your-client-id
MS_CLIENT_SECRET=your-client-secret

# Rejected Treasures Luxury Resale SharePoint identifiers.
SHAREPOINT_SITE_ID=your-sharepoint-site-id
SHAREPOINT_INVENTORY_LIST_ID=your-inventory-list-id
SHAREPOINT_PRODUCT_PHOTOS_DRIVE_ID=your-product-photos-drive-id

# URL for the self-hosted worker in services/photo-background-worker.
BACKGROUND_REMOVAL_API_URL=https://your-worker.example.com/remove
BACKGROUND_REMOVAL_API_TOKEN=generate-a-separate-worker-token
